---
import '../styles.css';
import { SiteLayout } from '../components/school/Layout';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "DM School Identity - Official Website" } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<SiteLayout client:load>
			<slot />
		</SiteLayout>
	</body>
</html>
